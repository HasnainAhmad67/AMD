# Copy to .env and adjust. Every TELLTALE_* value maps to apps/api/telltale_api/core/config.py.

# --- ports (docker compose) ---
# (The telltale start script picks free ports automatically and writes them here.)
API_PORT=8000
WEB_PORT=8080
DEV_WEB_PORT=5173

# --- paths (set automatically in Docker; local default is <repo>/data and <repo>/models) ---
# TELLTALE_DATA_DIR=./data
# TELLTALE_MODELS_DIR=./models

# --- API ---
TELLTALE_ENV=dev
TELLTALE_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
TELLTALE_SIMULATOR_ENABLED=true
TELLTALE_SIMULATOR_INTERVAL_S=3
TELLTALE_MAX_UPLOAD_MB=25
# Train the sensor model automatically on first start (OFFLINE=true skips the download, uses simulated data)
TELLTALE_SENSOR_AUTOTRAIN=true
TELLTALE_SENSOR_AUTOTRAIN_OFFLINE=false
# ONNX Runtime providers for sound models (needs an onnxruntime build with that provider)
# TELLTALE_ORT_PROVIDERS=ROCMExecutionProvider,CPUExecutionProvider

# --- demo authentication for /api/v1/assessments ONLY (all legacy routes stay open) ---
# Strict JSON object mapping actor -> bearer token. Empty/unset = assessments routes
# deny every request with 401. Malformed, empty or duplicate entries = deny (fail closed).
# Local demo only - NOT production authentication. Tokens are never logged or echoed.
# Send: Authorization: Bearer <token>   (the X-Actor-ID header is ignored)
# TELLTALE_API_TOKENS={"demo":"replace-with-a-long-random-token","reviewer":"replace-with-another"}

# --- optional LLM briefings (any OpenAI-compatible endpoint; unset = template text) ---
# TELLTALE_LLM_BASE_URL=http://llm:8001/v1
# TELLTALE_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# TELLTALE_LLM_API_KEY=not-needed

# --- Central AI Agent provider selection (/api/v1/ai/* endpoints) ---
# "template" (default) is the deterministic, offline provider for all five features.
# "amd" selects the AMD Token Factory static-key provider for /api/v1/ai/explain and
# /api/v1/ai/analyze ONLY; the other three features (evidence-review, report, ask) keep
# the template provider. An invalid value fails closed at startup; there is never a
# silent fallback.
TELLTALE_AI_PROVIDER=template

# --- AMD Token Factory (static Bearer API key; provider=amd, explain + analyze) ---
# Base URL is pinned to the documented AMD HTTPS host and base path.
# TELLTALE_AMD_API_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# The key is a SecretStr: it is never logged, echoed or serialized. Format: rc- + 48 hex.
# Never commit a real key: keep it only in your local .env or your shell environment.
# TELLTALE_AMD_API_KEY=
# TELLTALE_AMD_MODEL=
# Bounded transport limits: timeout <= 120 s, output tokens <= 4000, retries <= 3.
# TELLTALE_AI_TIMEOUT_S=30
# max_tokens is OPTIONAL: leave it unset (or "", "auto", "omit", "none") to OMIT max_tokens
# from the AMD request. Some AMD models reject an explicit max_tokens with HTTP 400
# (DeepSeek-V4-Flash reports its allowed maximum as null). Set a positive integer to send it.
# TELLTALE_AI_MAX_OUTPUT_TOKENS=
# TELLTALE_AI_MAX_RETRIES=1
# TELLTALE_AI_RETRY_MAX_S=2
# Terms: AMD Token Factory is a trial/development service (no SLA, models can change).
# AMD retains prompts/outputs for about two days (metadata longer); data is not sold or
# used for training. Do not send secrets or sensitive personal/health/financial data.

# --- AMD GPU overlay (docker-compose.rocm.yml) ---
# ROCM_PYTORCH_IMAGE=rocm/pytorch:rocm6.2_ubuntu22.04_py3.10_pytorch_release_2.3.0
# VLLM_IMAGE=rocm/vllm:latest
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# HF_TOKEN=
