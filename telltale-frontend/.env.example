# Local dev: where Vite forwards /api calls (your backend):
VITE_API_PROXY=http://127.0.0.1:8100
# Production: set this in Vercel to your backend origin, without a trailing slash.
# Example: https://telltale-api.onrender.com
VITE_API_BASE_URL=
# Public demo-only token; it is embedded in the browser bundle and is not a secret.
VITE_API_TOKEN=demo-token-123
